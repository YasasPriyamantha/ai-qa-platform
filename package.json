{
  "name": "ai-qa-platform",
  "version": "0.1.0",
  "description": "AI-powered QA automation platform for browser-based web applications",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "qa": "node dist/cli/index.js",
    "demo:v1": "node demo-apps/release-demo/server.mjs v1",
    "demo:v2": "node demo-apps/release-demo/server.mjs v2"
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "testing",
    "ai"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/mcp": "0.0.86",
    "openai": "^7.64.0",
    "zod": "^4.6.7"
  }
}
