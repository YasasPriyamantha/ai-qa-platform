# AI QA Automation Platform - Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env - it is Git-ignored and may contain secrets.

# ==============================================================================
# PLATFORM CONFIGURATION
# ==============================================================================
# These settings apply to the platform itself, not to individual projects.
# Platform credentials are loaded from this environment file, never from
# project.config.json.

# AI Provider Enable Flag (Phase 3+)
# Provider calls are disabled by default. Set to true to enable AI inference.
# Having an API key does not itself enable inference; this flag must also be true.
# Enforcement is implemented in Task 3.3.
AI_ENABLED=false

# AI Provider API Keys (Phase 3+)
# Used for hosted AI model inference. Not used in Phase 2.
# Multiple provider-specific keys may coexist; each provider ID maps to its own key.
# Model IDs are configuration values selected per provider entry, not hardcoded.
# Keep these secrets; never commit, log, or include in prompts/reports.

# OpenAI API Key
OPENAI_API_KEY=replace-with-your-openai-api-key

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Google AI Gemini API Key
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Custom providers (add as needed)
# Custom provider keys must use the reserved AI_PROVIDER_ namespace.
# This enables project-role validation and environment filtering to protect secrets.
# AI_PROVIDER_<PROVIDER_ID>_API_KEY=replace-with-your-provider-api-key


# ==============================================================================
# PROJECT TEST CREDENTIALS
# ==============================================================================
# These are environment variable values referenced by project role profiles.
# Project configs store only the VARIABLE NAMES, never secret values.
# The actual values are loaded from this .env file at runtime.
#
# Naming convention: <PROJECT>_<ROLE>_<CREDENTIAL>
# Examples below are for the SauceDemo project.

# SauceDemo standard user credentials
SAUCEDEMO_STANDARD_USER_USERNAME=standard_user
SAUCEDEMO_STANDARD_USER_PASSWORD=replace-with-test-password

# SauceDemo locked out user credentials (for negative testing)
SAUCEDEMO_LOCKED_OUT_USERNAME=locked_out_user
SAUCEDEMO_LOCKED_OUT_PASSWORD=replace-with-test-password

# SauceDemo problem user credentials (for edge-case testing)
SAUCEDEMO_PROBLEM_USER_USERNAME=problem_user
SAUCEDEMO_PROBLEM_USER_PASSWORD=replace-with-test-password


# ==============================================================================
# DEPRECATED
# ==============================================================================
# The generic AI_PROVIDER_API_KEY is deprecated and will not be used.
# If present, a migration warning will be logged but the key will be ignored.
# Use provider-specific keys instead (OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.)
#
# AI_PROVIDER_API_KEY=do-not-use-deprecated

# ==============================================================================
# NOTES
# ==============================================================================
# - Platform AI provider credentials (above) are distinct from project test
#   credentials. Provider keys are used to call inference APIs; test credentials
#   are used to log in to applications under test.
#
# - Multiple provider keys may coexist. Each configured provider uses its own key.
#   No universal AI_PROVIDER_API_KEY is assumed or used.
#
# - Built-in provider key names (OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY)
#   and AI_PROVIDER_* patterns are reserved and must not be used as project-role
#   credential references.
#
# - Project configs (project.config.json) reference test credential variable NAMES
#   in role profiles, but never store the actual values.
#
# - Authentication state files (.auth/<role-id>.json) may contain cookies and
#   tokens. They are Git-ignored and must never be logged or included in prompts.
#
# - For SauceDemo specifically, credentials are publicly known demo credentials,
#   but the convention remains the same for real applications.
