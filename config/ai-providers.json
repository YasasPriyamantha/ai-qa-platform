{
  "$schema": "./ai-providers.schema.json",
  "version": "1.0",
  "description": "AI provider configuration for the QA platform. This file is tracked in version control. Secret API key VALUES are stored in .env (git-ignored), not here. NOTE: The AI_ENABLED flag is fixed in code and cannot be configured here - only the exact value 'true' in .env enables provider calls.",
  "providers": [
    {
      "providerId": "openai",
      "adapterType": "openai-responses",
      "displayName": "OpenAI",
      "defaultModelId": "gpt-6-luna",
      "apiKeyEnvVar": "OPENAI_API_KEY",
      "enabled": true,
      "capabilities": {
        "toolCalling": "supported",
        "strictJsonSchema": "supported",
        "usageReporting": "supported",
        "reasoning": "unknown",
        "streaming": "supported",
        "imageInput": "supported"
      }
    },
    {
      "providerId": "anthropic",
      "adapterType": "anthropic-messages",
      "displayName": "Anthropic Claude",
      "defaultModelId": "claude-sonnet-4-20250514",
      "apiKeyEnvVar": "ANTHROPIC_API_KEY",
      "enabled": true,
      "capabilities": {
        "toolCalling": "supported",
        "strictJsonSchema": "unsupported",
        "usageReporting": "supported",
        "reasoning": "supported",
        "streaming": "supported",
        "imageInput": "supported"
      }
    },
    {
      "providerId": "gemini",
      "adapterType": "google-gemini",
      "displayName": "Google Gemini",
      "defaultModelId": "gemini-2.0-flash",
      "apiKeyEnvVar": "GEMINI_API_KEY",
      "enabled": true,
      "capabilities": {
        "toolCalling": "supported",
        "strictJsonSchema": "unknown",
        "usageReporting": "supported",
        "reasoning": "unknown",
        "streaming": "supported",
        "imageInput": "supported"
      }
    }
  ]
}
