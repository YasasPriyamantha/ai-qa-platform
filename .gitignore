# Generated project artifacts
project-data/**/artifacts/
tests/fixtures/**/artifacts/

# Do NOT ignore:
# - Source code and tests (*.ts)
# - Project configurations (project.config.json)
# - Fixture source files and configs
# - TypeScript configs
# - package.json