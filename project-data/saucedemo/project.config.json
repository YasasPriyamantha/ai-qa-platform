{
  "projectId": "saucedemo",
  "name": "SauceDemo Demo",
  "baseUrl": "https://www.saucedemo.com/",
  "environment": "demo",
  "allowedDomains": ["www.saucedemo.com"],
  "testDirectory": "tests/approved",
  "artifactDirectory": "artifacts",
  "documents": [
    { "documentId": "saucedemo-requirements", "sourcePath": "docs/requirements.md", "format": "markdown" }
  ],
  "roles": [
    {
      "roleId": "standard_user",
      "name": "Standard User",
      "credentials": {
        "username": "SAUCEDEMO_STANDARD_USER_USERNAME",
        "password": "SAUCEDEMO_STANDARD_USER_PASSWORD"
      },
      "storageStatePath": ".auth/standard_user.json"
    },
    {
      "roleId": "locked_out_user",
      "name": "Locked Out User",
      "credentials": {
        "username": "SAUCEDEMO_LOCKED_OUT_USERNAME",
        "password": "SAUCEDEMO_LOCKED_OUT_PASSWORD"
      },
      "storageStatePath": ".auth/locked_out_user.json"
    }
  ],
  "exploration": { "mode": "interactive" }
}
